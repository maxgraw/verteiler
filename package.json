		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@vitest/browser-playwright": "4.1.10",
		"playwright": "1.62.0",
		"svelte": "5.56.8",
		"svelte-check": "4.7.4",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"vitest": "4.1.10",
		"vitest-browser-svelte": "3.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "1.27.0",
		"highs": "1.15.2"
	}

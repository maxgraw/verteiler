{
	"name": "verteiler",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#routes/*": "./src/routes/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome ci .",
		"format": "biome check --write .",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "vitest --run",
		"verify": "bun run tools/verify/all.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@vitest/browser-playwright": "5.0.5",
		"playwright": "1.64.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "3.1.0"
	},
	"dependencies": {
		"@lucide/svelte": "1.59.0",
		"highs": "1.15.4",
		"jspdf": "4.2.1",
		"jspdf-autotable": "5.0.9"
	}
}
